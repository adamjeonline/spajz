{
  "name": "trustyshelf",
  "productName": "Spajz",
  "version": "1.0.0+0",
  "description": "Špajz: TV launcher for emulators, Steam and media apps (based on (T)rustyShelf and Boxshelf)",
  "license": "GPL-3.0-only",
  "main": "main.js",
  "private": true,
  "scripts": {
    "start": "electron .",
    "windowed": "electron . --windowed",
    "dist": "electron-builder --win portable",
    "dist:linux": "electron-builder --linux AppImage --publish never",
    "dist:win": "electron-builder --win portable --publish never"
  },
  "devDependencies": {
    "electron": "^39.2.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "io.github.trustyshelf",
    "productName": "Spajz",
    "files": [
      "main.js",
      "preload.js",
      "preload-home.js",
      "preload-wum.js",
      "main/**",
      "shared/**",
      "renderer/**",
      "package.json"
    ],
    "win": {
      "target": "portable",
      "icon": "renderer/app-icon.png",
      "artifactName": "Spajz-${version}-win-portable.${ext}"
    },
    "linux": {
      "target": "AppImage",
      "icon": "renderer/app-icon.png",
      "category": "Game",
      "desktop": {
        "entry": {
          "Name": "Špajz"
        }
      },
      "synopsis": "Špajz: TV launcher for emulators and Steam",
      "artifactName": "Spajz-${version}-linux.${ext}"
    },
    "artifactBuildStarted": "scripts/linux-wrapper.js",
    "asar": true,
    "asarUnpack": [
      "main/lbindex.js"
    ],
    "electronFuses": {
      "runAsNode": false,
      "enableNodeOptionsEnvironmentVariable": false,
      "enableNodeCliInspectArguments": false,
      "enableEmbeddedAsarIntegrityValidation": true,
      "onlyLoadAppFromAsar": true,
      "enableCookieEncryption": true
    }
  }
}